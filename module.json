  "languages": [
    {
      "lang": "de",
      "name": "Deutsch",
      "path": "lang/de.json"
    },
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "esmodules": [
    "modules/init.js"
  ],
  "styles": [
    "styles/css.css"
  ],
  "packs": [],
  "socket": true,
  "id": "crucibletongs",
  "authors": [ { "name": "Huepfklotz" } ],
  "compatibility": {
    "minimum": "13",
    "verified": "13",
    "maximum": "13"
  },
  "relationships": {
