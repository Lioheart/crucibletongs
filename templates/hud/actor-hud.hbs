<div>
    <div class="flexrow resources">
        <div class="flex0" data-tooltip-html="{{resources.health.label}} {{resources.health.value}}/{{resources.health.max}}<br>{{resources.wounds.label}} {{resources.wounds.value}}/{{resources.wounds.max}}"
            style="background:{{resources.health.color.high}};">
            {{resources.health.value}}/{{resources.health.max}}
        </div>
        <div class="flex0" data-tooltip-html="{{resources.morale.label}} {{resources.morale.value}}/{{resources.morale.max}}<br>{{resources.madness.label}} {{resources.madness.value}}/{{resources.madness.max}}"
            style="background:{{resources.morale.color.high}};">
            {{resources.morale.value}}/{{resources.morale.max}}
        </div>
    </div>
    <div class="avatar-container flexrow">
        <img class="avatar flex0 {{ifThen myTurn 'myRound' ''}}" src="{{actor.img}}" />
        {{#each weapons}}
        <div data-action="weapon" data-id="{{weapon.id}}" class="weapon" style="{{{style}}}">
            {{#if weapon.img}}
            <img data-tooltip="{{weapon.name}}" data-crucible-tooltip="weapon" data-item-id="{{weapon.id}}" data-uuid="{{weapon.uuid}}" data-tooltip-class="crucible crucible-tooltip" src="{{weapon.img}}" />
            {{else}}
            <i class="fas fa-hand"></i>
            {{/if}}
        </div>
        {{/each}}
    </div>
    <div class="flexrow quickbuttons" data-tooltip-direction="RIGHT">
        <div class="flex0 tongs-indicator" data-tooltip-class="crucible crucible-tooltip" data-tooltip-html="{{defenseTooltip}}"><i class="fas fa-shield"></i></div>
    </div>
    {{#if inCombat}}
    <div class="pips flexrow"
        data-tooltip="{{resources.action.label}} {{resources.action.value}}/{{resources.action.max}}">
        {{#each resources.action.pips as |pip|}}
        <div class="pip {{pip.cssClass}}"></div>
        {{/each}}
    </div>
    <div class="pips flexrow focus"
        data-tooltip="{{resources.focus.label}} {{resources.focus.value}}/{{resources.focus.max}}">
        {{#each resources.focus.pips as |pip|}}
        <div class="pip {{pip.cssClass}}"></div>
        {{/each}}
    </div>
    <div class="pips flexrow heroism"
        data-tooltip="{{resources.heroism.label}} {{resources.heroism.value}}/{{resources.heroism.max}}">
        {{#each resources.heroism.pips as |pip|}}
        <div class="pip {{pip.cssClass}}"></div>
        {{/each}}
    </div>
    {{/if}}
</div>