<div class="action line-item">
    <header class="action-header">
        <img class="icon" src="{{effect.img}}" alt="{{effect.name}}">
        <div class="title">
            <h4>{{effect.name}}</h4>
            {{#unless activation.empty}}
            <div class="tags">
                {{#each activation as |label tag|}}
                    <span class="tag" data-tag="{{tag}}">{{label}}</span>
                {{/each}}
            </div>
            {{/unless}}
        </div>
    </header>

    <div class="tags" data-tag-type="condition">
    {{#each tags as |label tag|}}
        <span class="tag" data-tag="{{tag}}">{{label}}</span>
    {{/each}}
    </div>

    <div class="description">{{{effect.description}}}</div>
</div>
